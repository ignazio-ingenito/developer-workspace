{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>skunklabs-uk/renovate-config"],
  "automerge": false,
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": [
        "ARG CODE_SERVER_VERSION=(?<currentValue>v[^\\s]+)\\nARG CODE_SERVER_DEB_SHA256=(?<currentDigest>[a-f0-9]{64})"
      ],
      "datasourceTemplate": "github-release-attachments",
      "depNameTemplate": "coder/code-server",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": [
        "ARG MISE_VERSION=(?<currentValue>v[^\\s]+)\\nARG MISE_SHA256=(?<currentDigest>[a-f0-9]{64})"
      ],
      "datasourceTemplate": "github-release-attachments",
      "depNameTemplate": "jdx/mise",
      "versioningTemplate": "semver-coerced"
    }
  ]
}
