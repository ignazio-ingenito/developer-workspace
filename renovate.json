{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "automerge": false,
  "customManagers": [
    {"customType":"regex","managerFilePatterns":["/^Dockerfile$/"],"matchStrings":["ARG CODE_SERVER_VERSION=(?<currentValue>[^\\s]+)"],"datasourceTemplate":"docker","depNameTemplate":"codercom/code-server"},
    {"customType":"regex","managerFilePatterns":["/^Dockerfile$/"],"matchStrings":["ARG MISE_VERSION=(?<currentValue>[^\\s]+)"],"datasourceTemplate":"github-releases","depNameTemplate":"jdx/mise"}
  ]
}
